{
  "manifest_version": 3,
  "name": "NOS Nieuws",
  "version": "1.0",
  "description": "Toont de laatste NOS-artikelen uit de algemene nieuwsfeed in een popup.",
  "host_permissions": ["https://feeds.nos.nl/*"],
  "permissions": ["alarms", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NOS Nieuws"
  }
}
