{
  "manifest_version": 3,
  "name": "NOS.nl",
  "version": "1.0",
  "description": "Toont de laatste NOS-artikelen uit de feed naar keuze in een popup.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": ["https://feeds.nos.nl/*"],
  "permissions": ["alarms", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NOS.nl"
  }
}
